rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.uid == 'wdhM824nJ9V7u2AHYXxz3CaG5VJ2';
    }
    function texto(value) {
      return value is string && value.size() > 0 && value.size() <= 160;
    }
    function inteiro(value, max) {
      return value is int && value >= 0 && value <= max;
    }
    function personagemValido(data) {
      return data.keys().hasAll(['nome', 'genero', 'player', 'rpg', 'estado',
          'participacoes', 'idade', 'altura', 'imagem', 'ordem', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['nome', 'genero', 'player', 'rpg', 'estado',
          'participacoes', 'idade', 'altura', 'imagem', 'ordem', 'createdAt', 'updatedAt'])
        && texto(data.nome) && texto(data.genero) && texto(data.player)
        && texto(data.rpg) && texto(data.estado)
        && inteiro(data.participacoes, 1000000)
        && (data.idade == null || data.idade == 'Indefinido' || inteiro(data.idade, 1000000000))
        && (data.altura == null || inteiro(data.altura, 1000000))
        && data.imagem is string && data.imagem.size() <= 2000
        && (data.imagem.matches('images/[^<>]+') || data.imagem.matches('https://[^<>]+'))
        && inteiro(data.ordem, 1000000000)
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /personagens/{id} {
      allow read: if true;
      allow create: if admin() && personagemValido(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if admin() && personagemValido(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.ordem == resource.data.ordem;
      allow delete: if admin();
    }
    match /configuracao/importacao {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasAll(['total', 'importedAt'])
        && request.resource.data.keys().hasOnly(['total', 'importedAt'])
        && inteiro(request.resource.data.total, 450) && request.resource.data.total > 0
        && request.resource.data.importedAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
